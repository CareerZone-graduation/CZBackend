# Server Configuration
NODE_ENV=test
PORT=5001 # Sử dụng một port khác để tránh xung đột

# JWT (Sử dụng secret khác cho an toàn)
JWT_SECRET=your-super-secret-test-key
JWT_REFRESH_SECRET=your-refresh-secret-test-key
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=10m

# Không cần các biến khác như Redis, RabbitMQ, Cloudinary
# vì chúng ta sẽ mock chúng khi cần thiết.
# DB_URI sẽ được cung cấp bởi mongodb-memory-server.
