# ========================================
# VNPay Configuration for CareerZone
# ========================================

# VNPay Merchant Code (get from VNPay)
# Sandbox test: Use the TMN code provided by VNPay sandbox
# Production: Get from VNPay after registration
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE

# VNPay Hash Secret (get from VNPay)
# Keep this secret! Never commit to version control
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET

# VNPay Payment Gateway URL
# Sandbox (test): https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Production: https://vnpayment.vn/paymentv2/vpcpay.html
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# VNPay Return URL (where user is redirected after payment)
# Must be accessible from internet for production
# Format: http://your-domain.com/api/payment/vnpay-return
VNPAY_RETURN_URL=http://localhost:5000/api/payment/vnpay-return

# VNPay IPN URL (server-to-server callback)
# Must be accessible from internet and whitelisted by VNPay
# Format: http://your-domain.com/api/payment/vnpay-ipn
VNPAY_IPN_URL=http://localhost:5000/api/payment/vnpay-ipn

# ========================================
# Frontend URLs for redirecting after payment
# ========================================
RECRUITER_FE_URL=http://localhost:4000
CANDIDATE_FE_URL=http://localhost:3000
ADMIN_FE_URL=http://localhost:5173

# ========================================
# Other existing configurations...
# ========================================
